
<templates id="template" xml:space="preserve">

    <t t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">

        <xpath expr="//div[contains(@class, 'product-name')]" position="after">
            <div class="sc-product-price">
                <t t-out="this.props.product.displayPriceUnit"/>
            </div>
        </xpath>

    </t>

</templates>
