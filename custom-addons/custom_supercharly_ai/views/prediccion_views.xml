
<odoo>
    <record id="action_supercharly_demand_forecast" model="ir.actions.act_window">
        <field name="name">Inteligencia de Inventario</field>
        <field name="res_model">supercharly.demand.forecast</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_supercharly_demand_forecast_list" model="ir.ui.view">
        <field name="name">supercharly.demand.forecast.list</field>
        <field name="model">supercharly.demand.forecast</field>
        <field name="arch" type="xml">

    <list string="Predicción de Demanda"
        create="false"
        delete="false">

        <header>
            <button name="generar_predicciones"
                    type="object"
                    string="Actualizar predicciones"
                    class="btn-primary"
                    display="always"/>
        </header>

        <field name="product_id" string="Producto" width="250px"/>
        <field name="qty_sold" string="Unidades vendidas (30 días)" width="190px"/>
        <field name="avg_daily_sales" string="Promedio diario de ventas" width="190px"/>
        <field name="forecast_qty" string="Demanda estimada (7 días)" width="190px"/>
        <field name="current_stock" string="Stock disponible" width="160px"/>
        <field name="suggested_qty" string="Cantidad recomendada para reponer" width="240px"/>
        <field name="last_updated" string="Última actualización" width="190px"/>

    </list>

        </field>
    </record>

    <menuitem id="menu_supercharly_demand_forecast"
              name="Inteligencia de Inventario"
              parent="stock.menu_stock_root"
              action="action_supercharly_demand_forecast"
              sequence="90"/>
</odoo>
