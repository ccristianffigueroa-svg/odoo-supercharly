        </Dialog>
    </t>
`);
registerTemplate("point_of_sale.ClosePosPopup", `/point_of_sale/static/src/app/components/popups/closing_popup/closing_popup.xml`, `<t t-name="point_of_sale.ClosePosPopup" xml:space="preserve">
