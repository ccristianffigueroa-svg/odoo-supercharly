registerTemplate("point_of_sale.ChoseComboPopup", `/point_of_sale/static/src/app/components/popups/chose_combo_popup/chose_combo_popup.xml`, `<t t-name="point_of_sale.ChoseComboPopup" xml:space="preserve">
