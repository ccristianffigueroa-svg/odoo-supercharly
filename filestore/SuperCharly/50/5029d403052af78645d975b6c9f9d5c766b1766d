registerTemplate("pos_stock.SelectLotPopup", `/pos_stock/static/src/app/components/popups/select_lot_popup/select_lot_popup.xml`, `<t t-name="pos_stock.SelectLotPopup" xml:space="preserve">
        <Dialog size="'md'">
            <t t-set-slot="header">
                <h4 class="modal-title title">
                    <span t-out="this.props.title"/> <span class="fst-italic" t-out="this.props.name"/>
                </h4>
            </t>
            <div t-ref="this.rootRef" class="lot-container" t-on-keydown="this.onKeyDown">
                <t t-if="!this.props.isSingleItem" t-foreach="this.state.values" t-as="v" t-key="v.id">
                    <div class="lot-item input-group mb-2">
                        <span class="form-control" t-out="v.text"/>
                        <button class="btn btn-danger" t-on-click="() =&gt; this.removeItem(v.id)">
                            <i class="oi" data-icon="delete"/>
                        </button>
                    </div>
                </t>
                <AutoComplete placeholder.translate="Lot/Serial number" sources="this.getSources()" value="this.state.value" autoSelect="true" autofocus="true" input="this.inputRef" onInput="(ev) =&gt; this.onInput(ev)" inputDebounceDelay="0"/>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="this.confirm">Apply</button>
                <button class="btn btn-secondary" t-on-click="this.close">Discard</button>
            </t>
       </Dialog>
    </t>
`);
