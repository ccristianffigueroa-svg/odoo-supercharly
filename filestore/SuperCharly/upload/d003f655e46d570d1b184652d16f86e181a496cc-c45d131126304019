registerTemplate("discuss.CallPresentationBar", `/mail/static/src/discuss/call/common/call_presentation_bar.xml`, `<t t-name="discuss.CallPresentationBar" xml:space="preserve">
        <div class="o-discuss-CallPresentationBar w-100 px-1 py-2">
            <div class="o-discuss-CallPresentationBar-container rounded-2 p-1 w-100 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2 ms-1 fw-medium overflow-hidden">
                    <AvatarStack personas="this.presenterPersonas" max="2" containerClass="'z-0'"/>
                    <div t-out="this.presenterText" t-att-title="this.presenterText" class="o-discuss-CallPresentationBar-presenterLabel opacity-75 text-truncate" t-att-class="{'o-self-presenter': this.rtc.selfSession.is_screen_sharing_on and this.rtc.screenAudioTrack}"/>
                    <div t-if="this.rtc.selfSession.is_screen_sharing_on and this.rtc.screenAudioTrack" t-on-click="this.togglePresentationAudio" class="o-discuss-CallPresentationBar-presentationAudioContainer cursor-pointer opacity-75 opacity-100-hover d-flex align-items-center gap-2 overflow-hidden">
                        <div class="o-discuss-CallPresentationBar-divider"/>
                        <div class="text-truncate"><i class="oi oi-fw me-1" t-att-data-icon="this.presentationAudio.enabled ? 'volume_up' : 'volume_off'"/>Presentation Audio</div>
                        <div class="form-check form-switch" title="Toggle Presentation Audio">
                            <input class="form-check-input" type="checkbox" role="switch" t-att-checked="this.presentationAudio.enabled"/>
                        </div>
                    </div>
                </div>
                <button t-if="this.rtc.selfSession.is_screen_sharing_on" class="btn btn-sm btn-secondary rounded flex-shrink-0" aria-label="Stop presenting" t-on-click="() =&gt; this.rtc.toggleVideo('screen', false)">Stop presenting</button>
            </div>
        </div>
    </t>
`);
registerTemplate("mail.CallPreview.actionList", `/mail/static/src/discuss/call/common/call_preview.xml`, `<t t-name="mail.CallPreview.actionList" xml:space="preserve">
        <ActionList actions="this.actions" inline="true" hasBtnBg="true"/>
    </t>
    `);
registerTemplate("mail.CallPreview", `/mail/static/src/discuss/call/common/call_preview.xml`, `<t t-name="mail.CallPreview" xml:space="preserve">
        <div class="o-mail-CallPreview ratio ratio-16x9">
            <div t-att-class="{'bg-dark rounded': this.env.inWelcomePage}">
                <video t-if="this.state.videoStream" class="object-fit-cover h-100 w-100 position-relative z-0" autoplay="" t-ref="this.videoRef"/>
                <div t-else="" class="position-absolute top-0 start-0 end-0 bottom-0 d-flex flex-column align-items-center justify-content-center text-center px-3 z-1" t-att-class="{'text-white': this.env.inWelcomePage}">
                    <div class="d-flex flex-column align-items-center justify-content-center flex-grow-1" t-att-class="{'mt-2': this.inWelcomePageMobile}">
                        <t t-if="this.env.inWelcomePage and this.rtc.cameraPermission !== 'granted'">
                            <span class="fs-3">Do you want people to see and hear you in the meeting?</span>
                            <button class="btn btn-primary mt-3" t-on-click="() =&gt; this.toggleCamera()">Allow Microphone and Camera</button>
                        </t>
                        <t t-else="">
                            <div class="d-flex flex-column align-items-center" t-att-class="{'mb-4': !this.env.inWelcomePage}">
                                <i class="oi oi-4x mb-2 opacity-50" data-icon="photo_camera"/>
                                <span class="fs-4 fw-bold">No Camera Preview</span>
                                <small class="opacity-50">
                                    <t t-if="this.rtc.cameraPermission !== 'granted'">Please allow access in your browser settings.</t>
                                    <t t-else="">Turn on your camera to see the preview.</t>
                                </small>
                            </div>
                        </t>
                    </div>
                    <div t-if="this.inWelcomePageMobile" class="d-flex justify-content-center mb-3">
                        <t t-call="mail.CallPreview.actionList"/>
                    </div>
                </div>
                <div t-if="this.state.videoStream or !this.inWelcomePageMobile" class="position-absolute bottom-0 mb-3 w-100 d-flex justify-content-center z-2">
                    <t t-call="mail.CallPreview.actionList"/>
                </div>
            </div>
            <audio autoplay="" t-ref="this.audioRef"/>
        </div>
        <div t-if="this.props.hasSettingsAtBottom" class="d-flex justify-content-center gap-2 flex-wrap flex-lg-nowrap w-100 mw-100 mt-2">
            <div class="o-mail-CallPreview-deviceSelect">
                <DeviceSelect iconClass="'oi oi-fw'" icon="'mic'" kind="'audioinput'" menuClass="this.store.discussDropdownMenuClass()"/>
            </div>
            <div class="o-mail-CallPreview-deviceSelect">
                <DeviceSelect iconClass="'oi oi-fw'" icon="'volume_up'" kind="'audiooutput'" menuClass="this.store.discussDropdownMenuClass()"/>
            </div>
            <div class="o-mail-CallPreview-deviceSelect">
                <DeviceSelect iconClass="'oi oi-fw oi-filled'" icon="'videocam'" kind="'videoinput'" menuClass="this.store.discussDropdownMenuClass()"/>
            </div>
            <a role="button" class="btn btn-secondary" t-on-click="this.onClickSettings" title="Advanced Settings">
                <i class="oi oi-fw oi-filled" data-icon="settings"/>
            </a>
        </div>
    </t>
`);
registerTemplate("discuss.CallRecordingIndicator", `/mail/static/src/discuss/call/common/call_recording_indicator.xml`, `<t t-name="discuss.CallRecordingIndicator" xml:space="preserve">
        <div t-ref="this.rootRef" t-attf-class="o-discuss-CallRecordingIndicator d-flex align-items-center gap-3 px-2 py-1 rounded-2 {{ this.props.className }}" t-att-class="{ 'o-hovered': this.rootHover.isHover }">
            <div class="o-discuss-CallRecordingIndicator-icons d-flex align-items-center gap-2">
                <i class="oi oi-filled text-danger o-blinking" data-icon="circle" role="img" title="Recording in progress"/>
                <i t-if="this.rtc.recordingState.video" title="recording video" class="oi" data-icon="desktop_windows" role="img"/>
                <i t-else="" title="recording audio only" class="oi" data-icon="mic" role="img"/>
                <i t-if="this.rtc.recordingState.transcription" title="transcription active" class="oi" data-icon="subtitles" role="img"/>
            </div>
            <button t-if="this.rootHover.isHover and this.rtc.canRecord()" class="btn btn-sm btn-danger" t-on-click="() =&gt; this.rtc.stopRecording()">Stop recording</button>
        </div>
    </t>

`);
registerTemplate("discuss.CallSettings", `/mail/static/src/discuss/call/common/call_settings.xml`, `<t t-name="discuss.CallSettings" xml:space="preserve">
