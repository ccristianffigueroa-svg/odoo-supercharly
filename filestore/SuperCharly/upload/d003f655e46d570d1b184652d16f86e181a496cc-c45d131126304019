                        <i class="oi" data-icon="east"/> See possible values
                    </a>
                </div>
                <ul t-if="this.state.moreInfoContent" class="o_import_report_more">
                    <li t-foreach="this.state.moreInfoContent" t-as="msg" t-key="msg_index"><t t-out="msg"/></li>
                </ul>
            </t>
        </div>
    </t>
`);
registerTemplate("ImportDataContent", `/base_import/static/src/import_data_content/import_data_content.xml`, `<t t-name="ImportDataContent" xml:space="preserve">
