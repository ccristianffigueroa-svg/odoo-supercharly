                            </div>
                            <div class="col-9">
                                <div name="keep_lines">
                                    <input type="checkbox" t-ref="this.keepLines" id="keep_lines_0"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-if="this.props.mode === 'import'" class="d-flex">
                    <div class="grid o_inner_group">
                        <div class="d-flex">
                            <div class="o_cell flex-grow-0 flex-sm-grow-0 text-900 pe-3">
                                <label class="o_form_label" for="next_serial_0">
                                    <t t-if="this.isLotTracking">Lot numbers</t>
                                    <t t-else="">Serial numbers</t>
                                </label>
                            </div>
                        </div>
                        <div class="o_cell flex-grow-1 flex-sm-grow-0">
                            <div name="next_serial" class="o_field_widget o_field_char">
                                <textarea placeholder="Write one lot/serial name per line, followed by the quantity." class="o_input" t-ref="this.lots" id="next_serial_0" type="text"/>
                            </div>
                        </div>
                        <div class="d-flex">
                            <div class="o_cell flex-grow-0 flex-sm-grow-0 text-900 pe-3">
                                <label class="o_form_label" for="keep_lines_0">Keep current lines</label>
                            </div>
                        </div>
                        <div class="o_cell flex-grow-1 flex-sm-grow-0">
                            <div name="keep_lines">
                                <input type="checkbox" t-ref="this.keepLines" id="keep_lines_0"/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </Dialog>
    </t>
`);
