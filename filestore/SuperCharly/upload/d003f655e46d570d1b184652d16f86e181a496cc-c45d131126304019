                    <div class="container">
                        <div class="row mb-2">
                            <div class="col-3">
                                <label class="o_form_label" for="next_serial_0">
                                    <t t-if="this.isLotTracking">First Lot Number</t>
                                    <t t-else="">First Serial Number</t>
                                </label>
                            </div>
                            <div class="col-7">
                                <div name="next_serial" class="o_field_widget o_field_char">
